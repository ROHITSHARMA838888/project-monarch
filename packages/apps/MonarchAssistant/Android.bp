android_app {
    name: "MonarchAssistant",
    srcs: ["src/**/*.java", "src/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
    ],
    optimize: {
        enabled: false,
    },
}
